# =================================================================
# Si-CAMBAH — Environment Variables Template
# =================================================================
#
# Copy file ini menjadi `.env`, lalu isi nilai-nilai di bawah.
#   cp .env.example .env
#
# JANGAN commit `.env` ke git — sudah masuk `.gitignore`.
#
# Setelah isi, jalankan: bash scripts/check-supabase.sh
# untuk verifikasi nilai-nilai-nya benar.
# =================================================================


# -----------------------------------------------------------------
# SUPABASE (WAJIB)
# -----------------------------------------------------------------
# Ambil dari: Supabase Dashboard → Settings → API
#
# Project URL — format: https://<project-ref>.supabase.co
# Project ref adalah string unik untuk project kamu.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — JWT yang dimulai dengan "eyJ..."
# Aman dishare di frontend bundle. Akses dibatasi via Row Level Security.
#
# JANGAN pakai service_role key di sini! Service_role bypass RLS,
# kalau bocor siapapun bisa hapus/baca semua data.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_starting_with_eyJ
